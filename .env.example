# =====================================================================
# Pipeline ETL Multi-Plataforma (TT) - Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio ni a GitHub.
# =====================================================================

# ---------------- YouTube Data API v3 / YouTube Analytics ------------
# Clave de API de Google Cloud Console con acceso a YouTube Data API v3
YOUTUBE_API_KEY=
# ID del canal de YouTube a extraer. Formato: UCxxxxxxxxxxxxxxxxxxxxxx (24 caracteres)
YOUTUBE_CHANNEL_ID=
# Ruta local al archivo JSON del cliente OAuth descargado de Google Cloud
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# ID del proyecto en Google Cloud Console (documentacion / trazabilidad)
GCP_PROJECT_ID=

# ---------------- Instagram Graph API (Meta) -------------------------
# Identificadores de la app en Meta for Developers
INSTAGRAM_APP_ID=
# Secreto de la aplicacion Meta
INSTAGRAM_APP_SECRET=
# Token de acceso de usuario de larga duracion (60 dias)
INSTAGRAM_ACCESS_TOKEN=
# Fecha en que expira el token de Meta (formato YYYY-MM-DD)
INSTAGRAM_TOKEN_EXPIRA=
# Identificadores de cuenta y pagina de Facebook asociada (se obtienen con tools/verificar_credenciales.py)
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# ---------------- Azure SQL Database (Data Warehouse) ----------------
# Nombre del servidor SQL en Azure (ejemplo: mi-servidor.database.windows.net)
AZURE_SERVER=
# Nombre de la base de datos SQL provisionada en Azure
AZURE_DATABASE=
# Nombre de usuario administrador de SQL (ej: CloudSAxxxx o admin_etl)
AZURE_USER=
# Contrasena del usuario. 
# IMPORTANTE: Si la contrasena contiene el caracter '#', colocala entre comillas dobles (ej: "Pass123#")
# para evitar que la libreria dotenv lo interprete como un comentario.
AZURE_PASSWORD=
