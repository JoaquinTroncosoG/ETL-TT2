# =====================================================================
# ETL Observatorio UX - Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =====================================================================

# ---------------- YouTube Data API v3 / YouTube Analytics ------------
YOUTUBE_API_KEY=
# ID del canal a extraer. Formato UCxxxxxxxxxxxxxxxxxxxxxx (24 caracteres)
YOUTUBE_CHANNEL_ID=
# Ruta al JSON del cliente OAuth (solo para YouTube Analytics API)
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# ID del proyecto de Google Cloud (trazabilidad / documentacion)
GCP_PROJECT_ID=

# ---------------- Instagram Graph API (Meta) -------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Token de larga duracion (60 dias)
INSTAGRAM_ACCESS_TOKEN=
# Fecha de expiracion del token, formato AAAA-MM-DD
INSTAGRAM_TOKEN_EXPIRA=
# Se descubren automaticamente con verificar_credenciales.py
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# ---------------- Azure SQL Database ---------------------------------
AZURE_SERVER=
AZURE_DATABASE=
AZURE_USER=
AZURE_PASSWORD=
